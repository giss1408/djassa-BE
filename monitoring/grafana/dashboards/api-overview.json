{
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests per second, by status class",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (class) (label_replace(rate(http_requests_total{path!~\"/health|/metrics\"}[5m]), \"class\", \"${1}xx\", \"status\", \"(.)..\"))",
          "legendFormat": "{{class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Server errors (5xx), share of requests",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{path!~\"/health|/metrics\"}[5m])), 0.001)",
          "legendFormat": "5xx share",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Latency p95, slowest routes",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, path) (rate(http_request_duration_seconds_bucket{path!~\"/health|/metrics\"}[10m]))))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Busiest routes",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "topk(8, sum by (method, path) (rate(http_requests_total{path!~\"/health|/metrics\"}[5m])))",
          "legendFormat": "{{method}} {{path}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Errors by route (4xx and 5xx)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "topk(8, sum by (path, status) (rate(http_requests_total{status=~\"[45]..\", path!~\"/health|/metrics\"}[10m])))",
          "legendFormat": "{{status}} {{path}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Running build (a change is a deploy)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "max by (commit) (hossouko_build_info)",
          "legendFormat": "{{commit}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 36,
  "title": "Hossouko API overview",
  "uid": "hossouko-api-overview",
  "tags": [
    "hossouko"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m"
}
