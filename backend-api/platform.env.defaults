# Settings of the platform deployment that are not secrets. `infra/scripts/make-product-env.sh fidelia .env.platform --defaults platform.env.defaults`
# merges them with infra/secrets/fidelia.env (database, redis, host), infra/secrets/fidelia.hooks.env (the number-change hook key) and
# generated secrets (`@random`, created once and kept). ${...} is expanded from those files and from: URL_SCHEME, PORT_SUFFIX, SERVICE_KEY
# (this product's key in the auth service's AUTH_SERVICE_KEYS_JSON).
#
# THIS IS A STAGING SETUP (FIDELIA_ENV=test: sample data, simulated payments). For production change, deliberately:
#   FIDELIA_ENV=production             (then CLOUDFLARE_ORIGIN_SECRET, 32+ characters, set by a Cloudflare transform rule, is mandatory)
#   CLOUDFLARE_ORIGIN_SECRET=...       FIDELIA_SEED_SAMPLE=0     MOBILE_MONEY_PROVIDER=<real>     OTP_SENDER=<real>     MEDIA_STORAGE=r2 (+ its keys)
#   FIDELIA_REJECT_ROLELESS=1          METRICS_TOKEN scraped by monitoring only        TEST_OTP_NUMBERS removed

# Redis (the product's ACL user): Celery and the shared rate-limit counters
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
RATE_LIMIT_STORAGE_URI=${REDIS_URL}

FIDELIA_ENV=test
FIDELIA_SECRET_KEY=@random
FIDELIA_ENCRYPTION_KEY=@random
METRICS_TOKEN=@random
MOBILE_MONEY_PROVIDER=fake
MOBILE_MONEY_SECRETS=@random
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=/app/media
LOG_FORMAT=json

# Sign-in through the platform auth service (SSO): tokens verified locally with the JWKS, money routes also ask the service
FIDELIA_SSO_ENABLED=1
FIDELIA_SSO_ISSUER=${URL_SCHEME}auth-api.${DOMAIN}${PORT_SUFFIX}
FIDELIA_SSO_JWKS_URL=http://auth-web:8000/.well-known/jwks.json
FIDELIA_SSO_AUTH_URL=http://auth-web:8000
FIDELIA_SSO_SERVICE_KEY=${SERVICE_KEY}
FIDELIA_SSO_MONEY_FAIL_CLOSED=1
