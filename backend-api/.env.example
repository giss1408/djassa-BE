# Example environment variables (DO NOT commit real secrets)
# Copy to .env and edit values locally ( .env is in .gitignore )

# Database
DATABASE_URL=postgresql+asyncpg://fidelia:fidelia@127.0.0.1:5432/fidelia

# JWT
FIDELIA_SECRET_KEY=change-me-in-dev

# Payment orchestration
PAYMENT_PROVIDER=sandbox
# Required for a live provider adapter; inject from a secret manager.
PAYMENT_PROVIDER_API_KEY=

# Customer QR payments (app/services/mobile_money.py). `fake` settles
# instantly for development and is refused when FIDELIA_ENV=production.
MOBILE_MONEY_PROVIDER=fake

# Signs the revenue statement shown to a microfinance partner
# (app/services/statement.py). Falls back to FIDELIA_SECRET_KEY if unset, but set
# it separately in production: rotating the JWT key would then invalidate every
# statement already in a partner's hands. Statements are refused outright rather
# than issued unsigned if neither is set.
FIDELIA_STATEMENT_SECRET=

# Docker registry (optional)
REGISTRY_URL=registry.example.com
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# WhatsApp number for suggestions to the Fidelia team (wa.me digits). Unset hides the menu entry.
FIDELIA_SUGGESTIONS_WHATSAPP=

# Layaway ("payer en plusieurs fois"), switched on per shop by an admin.
# Longest plan in days, and highest price in XOF.
LAYAWAY_MAX_DAYS=183
LAYAWAY_MAX_PRICE=1000000
